/* ═════════════ INSTALLED BASE (id: ib) ═════════════
   Question: how big is the fleet of ASML machines already in fabs, and how much recurring revenue does it generate?
   Every number is frozen here (€ millions unless noted). Sources next to each constant. */

/* ── Annual, 20-F (asml-work/data/annual.json) ──
   IBM = "net service and field option sales". 2015–2016 are as presented in the FY2017 20-F (ASC 605, M&I moved from service to
   systems; the FY2015/16 20-Fs themselves show 2015 service of 2,050.2). 2017 = ASC 606 as adjusted (FY2019 20-F). */
const IB_A_LBL = ['2015','2016','2017','2018','2019','2020','2021','2022','2023','2024','2025'];
const IB_A_IBM = [1977.0,2122.8,2538.3,2684.9,2823.8,3661.9,4958.2,5743.1,5619.9,6494.2,8193.0];
const IB_A_SYS = [4310.4,4672.0,6424.4,8259.1,8996.2,10316.6,13652.8,15430.3,21938.6,21768.7,24474.3];
const IB_A_TOT = [6287.4,6794.8,8962.7,10944.0,11820.0,13978.5,18611.0,21173.4,27558.5,28262.9,32667.3];
/* Lithography units shipped by technology (new + used), 20-F Note 2; 2026 9M = Q1–Q3'26 6-K presentation units (new + used). */
const IB_U_LBL = [...IB_A_LBL, '2026 9M'];
const IB_U = {
  EUV:    [1,4,11,18,26,31,42,40,53,44,48, 49],
  ArFi:   [67,70,76,86,82,68,81,81,125,129,131, 80],
  ArFdry: [9,6,13,16,22,22,22,28,32,28,16, 23],
  KrF:    [74,57,71,78,65,103,131,151,184,152,78, 100],
  iline:  [18,20,26,26,34,34,33,45,55,65,54, 39]
};
const IB_U_USED = [25,18,24,17,26,22,23,28,28,38,27, 25];        // used (refurbished) litho units resold; Q4 releases / 6-K press releases
const IB_USED_EUR = [127.7,71.8,91.5,143.5,189.1,155.8,206.7,278.0,316.2,629.0,575.7];   // used-system sales €M (20-F segment note, incl. M&I)
const IB_IBM_9M26 = 8538.0;    // Q1–Q3'26 IBM (6-K): 2,487.5 + 2,761.7 + 3,288.8
const IB_IBM_9M25 = 6058.9;    // Q1–Q3'25 IBM (6-K): 2,001.1 + 2,095.6 + 1,962.2
const IB_Q4_GUIDE = 3700;      // Q4'26 IBM "around €3.7B" (Q3'26 investor presentation, Oct 14 2026)

/* ── Bloomberg consensus, Oct 16 2026 (bbg_s1.tsv / bbg_s2.tsv, row "Installed Base Management", SALES_REV_TURN; total = IS_COMP_SALES) ── */
const IB_BBG_A = { lbl:['2026E','2027E','2028E','2029E'], ibm:[11949.5,14368.8,16597.7,17683.3], tot:[44444.1,57736.2,72319.9,79739.7] };
const IB_BBG_Q = { lbl:["Q4'26E","Q1'27E","Q2'27E","Q3'27E","Q4'27E"], ibm:[3579.0,3462.4,3595.1,3801.9,4007.6], tot:[14599.6,13075.6,13972.9,15143.6,16152.2] };

/* ── IBM guidance given one quarter earlier ("around"), aligned to Q_LBL (quarterly.json guidance_next_quarter.ibm_approx) ── */
const IB_Q_GUIDE = [null,1200,1400,1600,1500,1300,1400,1400,1300,1400,1400,1900,2100,2000,2000,2100,2400,2500,2900,3700];

const IB_COL = { ibm:'#5E8BEC', sys:'#1E2733', tot:'#A9B4C2', euv:'#2563EB', duv:'#3E5A82', navy:'#1E2733', steel:'#3E5A82' };
const IB_SRC_BBG = 'Bloomberg consensus, Oct 16 2026';

registerView({ id:'ib', html:`
    <div class="srow" id="ib-kpis"></div>

    <div class="card">
      <div class="ch">
        <div><div class="ct">How much recurring revenue does the fleet generate?</div><div class="cs" id="ib-t-s"></div></div>
        <div class="ctls">
          <span><span class="ctl-l">Period</span><div class="fbg" id="ib-t-per"><button class="fb active" data-v="a">Annual</button><button class="fb" data-v="q">Quarterly</button></div></span>
          <span><span class="ctl-l">Metric</span><div class="fbg" id="ib-t-met"><button class="fb active" data-v="lvl">€B</button><button class="fb" data-v="shr">% of sales</button><button class="fb" data-v="yoy">YoY %</button></div></span>
        </div>
      </div>
      <div class="cb"><div class="leg" id="ib-t-leg"></div><div class="ch-wrap"><canvas id="ib-t-cv"></canvas></div>
      <details class="tbl"><summary>Data table, method &amp; caveats</summary><div class="tw" id="ib-t-tbl"></div><div class="ib-m" id="ib-t-m"></div></details></div>
      <div class="snote">Source: 20-F FY2015–25; 6-K Q1'22–Q3'26; Q3'26 guide; ${IB_SRC_BBG}. No filing splits service from field options.</div>
    </div>

    <div class="card">
      <div class="ch">
        <div><div class="ct">Does IBM hold up when system sales fall?</div><div class="cs" id="ib-c-s"></div></div>
        <div class="ctls"><span><span class="ctl-l">Period</span><div class="fbg" id="ib-c-per"><button class="fb active" data-v="q">Quarterly</button><button class="fb" data-v="a">Annual</button></div></span></div>
      </div>
      <div class="cb"><div class="leg" id="ib-c-leg"></div><div class="ch-wrap"><canvas id="ib-c-cv"></canvas></div>
      <details class="tbl"><summary>Data table, method &amp; caveats</summary><div class="tw" id="ib-c-tbl"></div><div class="ib-m">
        <p>YoY % change of actuals only. Quarterly = 6-K results, Q1'23–Q3'26 against the same quarter a year earlier. Annual = 20-F, 2016–2025.</p>
        <p>2015–2016 are as re-presented in the FY2017 20-F (ASC 605; metrology &amp; inspection moved from service into systems), so 2016 growth is on that basis. The FY2015/16 20-Fs themselves show 2015 service of €2,050.2M. 2017 is ASC 606 as adjusted (FY2019 20-F).</p>
      </div></details></div>
      <div class="snote">Source: ASML 6-K quarterly results; 20-F FY2015–25. Actuals only, no estimates.</div>
    </div>

    <div class="card">
      <div class="ch"><div><div class="ct">How close does ASML's IBM guide land?</div><div class="cs" id="ib-g-s"></div></div></div>
      <div class="cb"><div class="leg" id="ib-g-leg"></div><div class="ch-wrap"><canvas id="ib-g-cv"></canvas></div>
      <details class="tbl"><summary>Data table, method &amp; caveats</summary><div class="tw" id="ib-g-tbl"></div><div class="ib-m">
        <p>Guide = the "around €X billion" IBM figure on the previous quarter's results slide (6-K investor presentations, Q1'22–Q3'26). Reported IBM = total net sales − net system sales.</p>
        <p>Q4'26: guide ~€3.7B vs Bloomberg Q4'26E €3.58B (${IB_SRC_BBG}, quarterly IBM row).</p>
      </div></details></div>
      <div class="snote">Source: ASML 6-K results and investor presentations. Guides are rounded ("around").</div>
    </div>

    <div class="card">
      <div class="ch">
        <div><div class="ct">How big is the fleet behind it?</div><div class="cs">Litho units shipped since 2015 (bars) vs IBM €B (line) · a proxy, not the installed base</div></div>
        <div class="ctls"><span><span class="ctl-l">View</span><div class="fbg" id="ib-f-mode"><button class="fb active" data-v="yr">Per year</button><button class="fb" data-v="cum">Cumulative</button></div></span></div>
      </div>
      <div class="cb"><div class="leg" id="ib-f-leg"></div><div class="ch-wrap"><canvas id="ib-f-cv"></canvas></div>
      <details class="tbl"><summary>Data table, fleet facts &amp; caveats</summary><div class="tw" id="ib-f-tbl"></div><div class="ib-m" id="ib-f-m"></div></details></div>
      <div class="snote">Source: 20-F Note 2 units; 6-K Q1–Q3'26; 2024 Investor Day. Includes resold used systems; excludes pre-2015 fleet.</div>
    </div>
`, css:`
  #v-ib .ib-m{padding:10px 13px;font-size:11.5px;line-height:1.55;color:var(--ink2);border-top:1px solid var(--bdr)}
  #v-ib .ib-m p{margin:0 0 6px} #v-ib .ib-m p:last-child{margin:0}
  #v-ib .ib-m ul{margin:4px 0 6px 16px;padding:0}
  #v-ib .ctls>span{display:flex;align-items:center}
  #v-ib td.ib-pos{color:#16A34A} #v-ib td.ib-neg{color:#DC2626}
`, init(){ ibInit(); } });

/* ═════════════ helpers ═════════════ */
const ibSum = arr => arr.reduce((a,b)=>a+b,0);
const ibDuv = IB_U_LBL.map((_,i) => IB_U.ArFi[i] + IB_U.ArFdry[i] + IB_U.KrF[i] + IB_U.iline[i]);
const ibFmtPct = (x,d=1) => x==null ? '—' : (x>=0?'+':'') + x.toFixed(d) + '%';
const ibAlpha = (hex, a) => hex + a;

/* Generic chart + legend + table renderer (zoom window st.x / st.y, hidden series st.hidden).
   spec: { cv, leg, tbl, labels, series:[{key,label,color,kind,data,est,axis,stack,pts}], isEst(i), fmtTip(v,s), fmtCell(v,s),
           y:{title,tick,stacked,min}, y1?, hdr, extra?(vis,lo,hi) → [[label, cells[]]], lo0 } */
function ibDraw(st, sp){
  const n = sp.labels.length; let lo = sp.lo0 || 0, hi = n-1;
  if(st.x){ lo = Math.max(lo, st.x[0]); hi = Math.min(hi, st.x[1]); }
  if(hi < lo){ hi = lo; }
  const lbl = sp.labels.slice(lo, hi+1), sl = a => a.slice(lo, hi+1);
  const vis = sp.series.filter(s => !st.hidden.has(s.key));
  const ds = vis.map(s => {
    const d = sl(s.data);
    if(s.kind === 'bar') return { type:'bar', label:s.label, data:d, yAxisID:s.axis||'y', stack:s.stack, skipNull:true, order:2,
      backgroundColor: s.est ? ibAlpha(s.color, s.est==='c' ? '40' : '88') : s.color, borderColor:s.color, borderWidth: s.est ? 1 : 0, borderRadius:2, barPercentage:.8, categoryPercentage:.8 };
    return { type:'line', label:s.label, data:d, yAxisID:s.axis||'y', order:1, borderColor:s.color, backgroundColor:s.color, borderWidth: s.pts ? 0 : 2,
      showLine: !s.pts, pointRadius: s.pts ? 5 : 2.5, pointStyle: s.pts || 'circle', pointHoverRadius:6, tension:.2, spanGaps:false,
      borderDash: s.est ? [5,4] : undefined, segment: s.estFrom!=null ? { borderDash: c => (c.p1DataIndex+lo) >= s.estFrom ? [5,4] : undefined } : undefined };
  });
  const yr = st.y;
  const opt = { responsive:true, maintainAspectRatio:false, animation:false, interaction:{ mode:'index', intersect:false },
    plugins:{ legend:{display:false}, tooltip:{ ...TIP, callbacks:{
      title: it => it[0].label + (sp.isEst(it[0].dataIndex+lo) ? ' — estimate' : ''),
      label: it => { const y = it.parsed.y; if(y==null) return null; return ' ' + it.dataset.label + ': ' + sp.fmtTip(y, vis[it.datasetIndex]); } } } },
    scales:{ x:{ grid:{display:false}, stacked: !!sp.y.stacked },
      y:{ stacked: !!sp.y.stacked, grid:{color:'#EEF1F5'}, title:{display:true, text:sp.y.title}, ticks:{ callback:sp.y.tick },
          min: yr ? yr[0] : sp.y.min, max: yr ? yr[1] : undefined } } };
  if(sp.y1) opt.scales.y1 = { display: vis.some(s=>s.axis==='y1'), position:'right', grid:{display:false}, beginAtZero:true,
      title:{display:true, text:sp.y1.title}, ticks:{ callback:sp.y1.tick } };
  if(st.chart) st.chart.destroy();
  st.chart = new Chart($('#'+sp.cv), { data:{ labels:lbl, datasets:ds }, options:opt });
  st.chart.$lo = lo;
  legend($('#'+sp.leg), sp.series.map(s => ({ key:s.key, label:s.label, color: s.est==='c' ? ibAlpha(s.color,'66') : s.color, line: s.kind==='line', dash: !!s.est && s.kind==='line' })), st.hidden, st.render);
  // table: carries everything drawn (visible range × visible series) plus any extra rows
  const cols = lbl.map((l,i) => `<th class="${sp.isEst(i+lo)?'est':''}">${l}</th>`).join('');
  const rows = vis.map(s => [s.label, sl(s.data).map(v => sp.fmtCell(v, s)), s.est]);
  if(sp.extra) sp.extra(vis, lo, hi).forEach(r => rows.push(r));
  $('#'+sp.tbl).innerHTML = `<table><thead><tr><th>${sp.hdr}</th>${cols}</tr></thead><tbody>` +
    rows.map(([name, cells, est]) => `<tr><td>${name}</td>${cells.map((c,i) => { const isE = est || sp.isEst(i+lo);
      const cls = (isE?'est ':'') + (typeof c==='object' && c && c.cls ? c.cls : ''); return `<td class="${cls}">${typeof c==='object' && c ? c.t : c}</td>`; }).join('')}</tr>`).join('') + '</tbody></table>';
  return { lo, hi };
}
function ibZoom(st){
  attachZoom(() => st.chart, r => { if(!r){ st.x=null; st.y=null; } else { if(r.x) st.x=r.x; if(r.y) st.y=r.y; } st.render(); });
}
function ibPills(sel, fn){
  $$(sel + ' .fb').forEach(b => b.onclick = () => { $$(sel + ' .fb').forEach(x => x.classList.remove('active')); b.classList.add('active'); fn(b.dataset.v); });
}

/* ═════════════ KPIs ═════════════ */
function ibKpis(){
  const fy = IB_A_IBM[10];
  const fy26 = IB_IBM_9M26 + IB_Q4_GUIDE;
  const k = [
    ['g','FY2025 IBM', fmtB(fy,2), `${pct(fy/IB_A_TOT[10],0)} of total net sales`],
    ['a','9M 2026 IBM', fmtB(IB_IBM_9M26,2), `${sgn(IB_IBM_9M26/IB_IBM_9M25-1)} vs 9M 2025`],
    ['b','FY2026 run-rate', '~' + fmtB(fy26,1), `9M + Q4 guide · consensus ${fmtB(IB_BBG_A.ibm[0],2)}`],
    ['p','Installed base', '>6,000', 'systems, 2024 Investor Day']
  ];
  $('#ib-kpis').innerHTML = k.map(([c,l,v,s]) => `<div class="sc ${c}"><div class="sl">${l}</div><div class="sv">${v}</div><div class="ss">${s}</div></div>`).join('');
}

/* ═════════════ 1 · IBM over time ═════════════ */
const ibT = { per:'a', met:'lvl', hidden:new Set(), x:null, y:null, chart:null };
function ibTData(){
  const N = null;
  if(ibT.per === 'a'){
    const labels = [...IB_A_LBL, ...IB_BBG_A.lbl];
    const act = [...IB_A_IBM, N,N,N,N], actT = [...IB_A_TOT, N,N,N,N];
    const gd = labels.map((_,i) => i===11 ? IB_IBM_9M26 + IB_Q4_GUIDE : N);
    const gdT = labels.map((_,i) => i===11 ? Q_TOT[16]+Q_TOT[17]+Q_TOT[18]+Q_TOT[19] : N);
    const bb = [...IB_A_LBL.map(()=>N), ...IB_BBG_A.ibm], bbT = [...IB_A_LBL.map(()=>N), ...IB_BBG_A.tot];
    return { labels, k:1, estFrom:11, act, actT, gd, gdT, bb, bbT, gdLbl:'2026: 9M actual + Q4 guide' };
  }
  const extra = IB_BBG_Q.lbl.slice(1);                                     // Q1'27E..Q4'27E
  const labels = [...Q_LBL, ...extra];
  const act = [...Q_TOT.map((t,i) => i < Q_EST ? t - Q_SYS[i] : N), ...extra.map(()=>N)];
  const actT = [...Q_TOT.map((t,i) => i < Q_EST ? t : N), ...extra.map(()=>N)];
  const gd = labels.map((_,i) => i===Q_EST ? IB_Q4_GUIDE : N), gdT = labels.map((_,i) => i===Q_EST ? Q_TOT[Q_EST] : N);
  const bb = labels.map((_,i) => i>=Q_EST ? IB_BBG_Q.ibm[i-Q_EST] : N), bbT = labels.map((_,i) => i>=Q_EST ? IB_BBG_Q.tot[i-Q_EST] : N);
  return { labels, k:4, estFrom:Q_EST, act, actT, gd, gdT, bb, bbT, gdLbl:"Q4'26 guide (~€3.7B)" };
}
function ibTRender(){
  const d = ibTData(), m = ibT.met;
  const tr = (arr, tot) => arr.map((v,i) => {
    if(v == null) return null;
    if(m === 'lvl') return v/1000;
    if(m === 'shr') return v / tot[i] * 100;
    const j = i - d.k; if(j < 0) return null;
    const base = d.act[j] != null ? d.act[j] : arr[j];               // growth vs the actual a year earlier, else vs the same series
    return base == null ? null : (v/base - 1) * 100;
  });
  const series = [
    { key:'act', label:'IBM — actual', color:IB_COL.ibm, kind:'bar', data:tr(d.act, d.actT) },
    { key:'gd',  label:d.gdLbl.replace('2026: 9M actual + Q4 guide','2026: 9M + Q4 guide'), color:IB_COL.ibm, kind:'bar', est:'g', data:tr(d.gd, d.gdT) },
    { key:'bb',  label:'Bloomberg consensus (Oct 16 2026)', color:IB_COL.steel, kind:'bar', est:'c', data:tr(d.bb, d.bbT) }
  ];
  const u = m === 'lvl' ? '€B' : m === 'shr' ? '% of sales' : 'YoY %';
  ibDraw(ibT, { cv:'ib-t-cv', leg:'ib-t-leg', tbl:'ib-t-tbl', labels:d.labels, series, lo0: ibT.per==='a' && m==='yoy' ? 1 : (ibT.per==='q' && m==='yoy' ? 4 : 0),
    isEst: i => i >= d.estFrom, hdr: u,
    y:{ title: m==='lvl' ? 'IBM, € billions' : m==='shr' ? 'IBM as % of total net sales' : 'IBM growth, YoY %', tick: x => m==='lvl' ? '€'+x : x+'%', min: m==='yoy' ? undefined : 0 },
    fmtTip: v => m==='lvl' ? '€'+v.toFixed(2)+'B' : m==='shr' ? v.toFixed(1)+'%' : ibFmtPct(v),
    fmtCell: v => v==null ? '—' : m==='lvl' ? v.toFixed(2) : m==='shr' ? v.toFixed(1)+'%' : ibFmtPct(v) });
  $('#ib-t-s').textContent = 'Service + field options · ' + (m==='lvl' ? '€ billions' : m==='shr' ? '% of total net sales' : 'YoY %') + ' · light bars = guide / consensus';
}

/* ═════════════ 2 · Through the cycle ═════════════ */
const ibC = { per:'q', hidden:new Set(), x:null, y:null, chart:null };
function ibCRender(){
  let labels, sys, ibm, tot;
  const yoy = (a, k) => a.map((v,i) => i < k ? null : (v/a[i-k]-1)*100);
  if(ibC.per === 'q'){
    const qi = Q_TOT.map((t,i)=>t-Q_SYS[i]).slice(0, Q_EST), qs = Q_SYS.slice(0, Q_EST), qt = Q_TOT.slice(0, Q_EST);
    labels = Q_LBL.slice(4, Q_EST); sys = yoy(qs,4).slice(4); ibm = yoy(qi,4).slice(4); tot = yoy(qt,4).slice(4);
  } else {
    labels = IB_A_LBL.slice(1); sys = yoy(IB_A_SYS,1).slice(1); ibm = yoy(IB_A_IBM,1).slice(1); tot = yoy(IB_A_TOT,1).slice(1);
  }
  const series = [
    { key:'sys', label:'Net system sales', color:IB_COL.sys, kind:'line', data:sys },
    { key:'ibm', label:'Installed Base Mgmt', color:IB_COL.ibm, kind:'line', data:ibm },
    { key:'tot', label:'Total net sales', color:IB_COL.tot, kind:'line', data:tot }
  ];
  const r = ibDraw(ibC, { cv:'ib-c-cv', leg:'ib-c-leg', tbl:'ib-c-tbl', labels, series, isEst: () => false, hdr:'YoY %',
    y:{ title:'YoY growth %', tick: x => x+'%' }, fmtTip: v => ibFmtPct(v), fmtCell: v => ibFmtPct(v),
    extra: (vis, lo, hi) => {
      const stats = vis.map(s => { const w = s.data.slice(lo, hi+1).filter(v => v!=null); return [s, Math.min(...w), Math.max(...w)]; });
      return stats.length ? [['<b>Range shown (min / max)</b>', labels.slice(lo, hi+1).map((_,i) => i===0 ? stats.map(([s,a,b]) => `${s.label}: ${ibFmtPct(a,0)} / ${ibFmtPct(b,0)}`).join('<br>') : '')]] : [];
    } });
  // one-line evidence for the visible window
  const win = a => a.slice(r.lo, r.hi+1);
  const lowOf = a => { const w = win(a); let k = -1; w.forEach((v,i) => { if(v!=null && (k<0 || v < w[k])) k = i; }); return k<0 ? null : [labels[k+r.lo], w[k]]; };
  const ls = lowOf(sys), li = lowOf(ibm), neg = a => win(a).filter(v => v!=null && v<0).length;
  $('#ib-c-s').textContent = `YoY % · worst shown: systems ${ls?ls[0]+' '+ibFmtPct(ls[1],0):'—'}, IBM ${li?li[0]+' '+ibFmtPct(li[1],0):'—'} · declines: systems ${neg(sys)}, IBM ${neg(ibm)}`;
}

/* ═════════════ 3 · Guide vs actual ═════════════ */
const ibG = { hidden:new Set(), x:null, y:null, chart:null };
function ibGRender(){
  const lo = 1;                                                             // first guided quarter = Q2'22
  const labels = Q_LBL.slice(lo);
  const act = Q_TOT.slice(lo).map((t,i) => (i+lo) < Q_EST ? (t - Q_SYS[i+lo]) / 1000 : null);
  const gd = IB_Q_GUIDE.slice(lo).map(v => v==null ? null : v/1000);
  const bb = labels.map((_,i) => (i+lo)===Q_EST ? IB_BBG_Q.ibm[0]/1000 : null);
  const series = [
    { key:'act', label:'IBM — reported', color:IB_COL.ibm, kind:'bar', data:act },
    { key:'gd',  label:'Guide given a quarter earlier (~)', color:IB_COL.navy, kind:'line', pts:'rectRot', data:gd },
    { key:'bb',  label:"Bloomberg Q4'26E", color:IB_COL.steel, kind:'line', pts:'triangle', est:'c', data:bb }
  ];
  ibDraw(ibG, { cv:'ib-g-cv', leg:'ib-g-leg', tbl:'ib-g-tbl', labels, series, isEst: i => (i+lo) >= Q_EST, hdr:'€B',
    y:{ title:'€ billions', tick: x => '€'+x, min:0 }, fmtTip: v => '€'+v.toFixed(2)+'B', fmtCell: v => v==null ? '—' : v.toFixed(2),
    extra: (vis, a, b) => {
      if(ibG.hidden.has('act') || ibG.hidden.has('gd')) return [];
      const diff = act.slice(a, b+1).map((v,i) => { const g = gd[i+a]; if(v==null || g==null) return '—'; const dlt = (v-g)*1000;
        return { t: (dlt>=0?'+':'') + dlt.toFixed(0) + ' (' + ibFmtPct((v/g-1)*100,0) + ')', cls: dlt>=0 ? 'ib-pos' : 'ib-neg' }; });
      return [['Reported − guide, €M (%)', diff]];
    } });
  const pairs = act.map((v,i) => [v, gd[i]]).filter(([v,g]) => v!=null && g!=null);
  const above = pairs.filter(([v,g]) => v >= g).length;
  const avg = ibSum(pairs.map(([v,g]) => (v/g-1)*100)) / pairs.length;
  $('#ib-g-s').textContent = `€ billions · at or above guide in ${above} of ${pairs.length} quarters · average gap ${ibFmtPct(avg,1)}`;
}

/* ═════════════ 4 · Fleet proxy ═════════════ */
const ibF = { mode:'yr', hidden:new Set(), x:null, y:null, chart:null };
function ibFRender(){
  const cum = a => { let s = 0; return a.map(v => s += v); };
  const c = ibF.mode === 'cum';
  const euv = c ? cum(IB_U.EUV) : IB_U.EUV, duv = c ? cum(ibDuv) : ibDuv, used = c ? cum(IB_U_USED) : IB_U_USED;
  const ibm = [...IB_A_IBM, IB_IBM_9M26].map(v => v/1000);
  const series = [
    { key:'euv', label:'EUV units', color:IB_COL.euv, kind:'bar', stack:'u', data:euv },
    { key:'duv', label:'DUV units', color:IB_COL.duv, kind:'bar', stack:'u', data:duv },
    { key:'ibm', label:'IBM €B (right axis)', color:IB_COL.ibm, kind:'line', axis:'y1', data:ibm }
  ];
  ibDraw(ibF, { cv:'ib-f-cv', leg:'ib-f-leg', tbl:'ib-f-tbl', labels:IB_U_LBL, series, isEst: () => false, hdr: c ? 'Cumulative since 2015' : 'Per year',
    y:{ title: c ? 'litho units shipped since 2015 (new + used)' : 'litho units shipped (new + used)', tick: x => x, stacked:true, min:0 },
    y1:{ title:'IBM, € billions', tick: x => '€'+x },
    fmtTip: (v,s) => s.axis==='y1' ? '€'+v.toFixed(2)+'B' : v.toLocaleString('en-US') + ' units',
    fmtCell: (v,s) => v==null ? '—' : s.axis==='y1' ? '€'+v.toFixed(2)+'B' : v.toLocaleString('en-US'),
    extra: (vis, lo, hi) => {
      const rows = [], sh = k => !ibF.hidden.has(k);
      if(sh('euv') || sh('duv')) rows.push(['<b>Units shown (EUV + DUV)</b>', IB_U_LBL.slice(lo,hi+1).map((_,i) => `<b>${((sh('euv')?euv[i+lo]:0) + (sh('duv')?duv[i+lo]:0)).toLocaleString('en-US')}</b>`)]);
      rows.push(['of which used, resold (all litho)', used.slice(lo,hi+1).map(v => v.toLocaleString('en-US'))]);
      if(!c) rows.push(['Used-system sales, €M (incl. M&amp;I)', IB_U_LBL.slice(lo,hi+1).map((_,i) => IB_USED_EUR[i+lo]!=null ? IB_USED_EUR[i+lo].toFixed(1) : '—')]);
      return rows;
    } });
}

/* ═════════════ Method / caveat notes (inside the dropdowns) ═════════════ */
function ibFacts(){
  const perSys = IB_A_IBM[9] / 6000 * 1000;   // € thousands per system, 2024 IBM ÷ ">6,000" → an upper bound
  // Section 4 dropdown: fleet facts + proxy caveats (plain list, no boxes)
  $('#ib-f-m').innerHTML = `<p><b>Proxy caveats.</b> Bars are lithography units shipped since 2015 (new + used); the fleet goes back to the 1990s, and a used resale is not a new fleet addition (used units are in the table). DUV = ArFi + ArF dry + KrF + i-line; metrology &amp; inspection excluded. IBM 2026 = first nine months only.</p>
    <p><b>What the filings say about the fleet:</b></p><ul>
    <li>Installed base <b>&gt;6,000 systems</b>, immersion alone &gt;1,300 (2024 Investor Day, p. 11, 6-K Ex. 99.5). No yearly count in the 20-F.</li>
    <li>IBM per installed system <b>&lt; €${(perSys/1000).toFixed(2)}M a year</b>: 2024 IBM €${(IB_A_IBM[9]/1000).toFixed(2)}B ÷ &gt;6,000 (upper bound; Claude's arithmetic).</li>
    <li><b>~95%</b> of systems sold in the last 30 years still in use at end-2025; service lifetime "more than 20 years"; PAS 5500 supported to at least 2035; ~200 TWINSCAN AT still operating. ASML says it will stop reporting the 95% figure.</li>
    <li><b>&gt;600</b> systems refurbished and resold; 27 in 2025; used-system sales €${IB_USED_EUR[10].toFixed(1)}M. Refurbishment families: PAS 5500 (~1,800), XT (2,000), NXT:1950–1980 (1,000), counts as stated.</li>
    <li>Field upgrades: PEP-E lifted NXE:3800E from 220 to 230 wafers/hour; NXE:3800E field upgrades moved "a substantial portion of EUV system revenue" into IBM in 2025.</li>
    <li>2025 IBM +26.2%: growing installed base, higher tool use at certain customers, more NXE field upgrades. ~10,000 customer-support staff.</li></ul>
    <p>Sources: 20-F FY2015–25 Note 2 (units), Q4 releases (used units), 6-K Q1–Q3'26; Annual Report / 20-F FY2025 (products pages; Climate p. 172; Circular economy pp. 192–193; Financial performance; segment note).</p>`;

  // Section 1 dropdown: method + consensus reconciliation
  const fy26 = IB_IBM_9M26 + IB_Q4_GUIDE, bbgQsum26 = IB_IBM_9M26 + IB_BBG_Q.ibm[0], bbgQsum27 = ibSum(IB_BBG_Q.ibm.slice(1));
  $('#ib-t-m').innerHTML = `<p><b>Definition.</b> IBM = net service and field option sales (20-F). No 20-F or Q4 release splits service from field options/upgrades.</p>
    <p><b>Run-rate vs consensus.</b> 9M26 ${fmtB(IB_IBM_9M26,2)} + Q4 guide ~€3.7B = ~${fmtB(fy26,2)} for 2026 vs Bloomberg 2026E ${fmtB(IB_BBG_A.ibm[0],2)} (+${fmtB(fy26-IB_BBG_A.ibm[0],2)}; SAB's consensus walkthrough, Oct 21 2026). 2026 % of sales uses the Q4 sales midpoint €14.7B.</p>
    <p><b>Bloomberg inconsistencies.</b> Quarterly Q4'26E ${fmtB(IB_BBG_Q.ibm[0],2)} sits below the guide, and quarters do not add to the annual row (2026: 9M + Q4E = ${fmtB(bbgQsum26,2)} vs ${fmtB(IB_BBG_A.ibm[0],2)}; 2027: ${fmtB(bbgQsum27,2)} vs ${fmtB(IB_BBG_A.ibm[1],2)}). Consensus % of sales uses Bloomberg total revenue.</p>
    <p><b>For scale.</b> The 2024 Investor Day put 2030 IBM at €11–13B (low–high scenario); consensus 2027E is ${fmtB(IB_BBG_A.ibm[1],1)}.</p>
    <p><b>Basis.</b> 2015–16 as re-presented in the FY2017 20-F (ASC 605, M&amp;I moved to systems); 2017 ASC 606 as adjusted (FY2019 20-F). Quarterly from 6-K results; Q4'26 guide from the Q3'26 presentation (Oct 14 2026).</p>`;
}

/* ═════════════ wiring ═════════════ */
ibT.render = ibTRender; ibC.render = ibCRender; ibG.render = ibGRender; ibF.render = ibFRender;
ibPills('#ib-t-per', v => { ibT.per = v; ibT.x = null; ibT.y = null; ibTRender(); });
ibPills('#ib-t-met', v => { ibT.met = v; ibT.x = null; ibT.y = null; ibTRender(); });
ibPills('#ib-c-per', v => { ibC.per = v; ibC.x = null; ibC.y = null; ibCRender(); });
ibPills('#ib-f-mode', v => { ibF.mode = v; ibF.y = null; ibFRender(); });

function ibInit(){
  ibKpis(); ibFacts();
  ibTRender(); ibZoom(ibT);
  ibCRender(); ibZoom(ibC);
  ibGRender(); ibZoom(ibG);
  ibFRender(); ibZoom(ibF);
}
